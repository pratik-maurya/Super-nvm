@echo off
title Super NVM - Universal Multi-Editor Installer
setlocal enabledelayedexpansion

if exist "%~dp0bin\install-editors.ps1" (
    powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0bin\install-editors.ps1"
    goto :done
)

if exist "%~dp0install-editors.ps1" (
    powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0install-editors.ps1"
    goto :done
)

:: Self-contained fallback when run alone in Downloads folder
powershell -NoProfile -ExecutionPolicy Bypass -Command "$b=''; [System.Text.Encoding]::UTF8.GetString([System.Convert]::FromBase64String($b)) | Invoke-Expression"

:done
if %ERRORLEVEL% NEQ 0 (
    echo.
    pause
)